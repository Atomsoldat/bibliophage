# Bibliophage Web UI - Environment Variables Example
# Copy this file to .env.local for local development overrides

# Backend API host (highest priority configuration)
# Overrides both config.json and hardcoded defaults
# Example: VITE_BACKEND_HOST=http://localhost:8000
# Example: VITE_BACKEND_HOST=https://api.bibliophage.example.com
VITE_BACKEND_HOST=
