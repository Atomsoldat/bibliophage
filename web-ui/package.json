{
  "name": "vue-ui",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@4.11.0",
  "scripts": {
    "dev": "NODE_OPTIONS=--no-experimental-webstorage vite",
    "api": "protoc --proto_path=../api --es_out ./src --es_opt target=ts --connect-es_out ./src --connect-es_opt target=ts ../api/bibliophage/v1alpha3/*.proto",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "knip": "knip",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "dependencies": {
    "@antfu/eslint-config": "^6.7.1",
    "@bufbuild/protobuf": "^1.10.1",
    "@codemirror/commands": "^6.10.1",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.1",
    "@codemirror/state": "^6.5.3",
    "@codemirror/view": "^6.39.8",
    "@connectrpc/connect": "^1.7.0",
    "@connectrpc/connect-web": "^1.7.0",
    "@floating-ui/dom": "^1.7.4",
    "@vue/compiler-sfc": "^3.5.25",
    "@vueuse/core": "^14.1.0",
    "eslint": "^9.39.2",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "marked": "^17.0.1",
    "pinia": "^2.3.1",
    "sigma": "^3.0.0",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^1.10.1",
    "@connectrpc/protoc-gen-connect-es": "^1.7.0",
    "@iconify/vue": "^5.0.0",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/devtools": "^8.0.3",
    "@vue/tsconfig": "^0.8.1",
    "daisyui": "^5.5.5",
    "knip": "^5.70.1",
    "protoc": "^33.0.0",
    "sass-embedded": "^1.93.3",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-vue-devtools": "^8.0.5",
    "@pinia/testing": "^0.1.6",
    "vue-tsc": "^3.1.4"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14"
  }
