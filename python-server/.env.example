# Example environment variables for bibliophage server
# Copy this file to .env for local development (NOT committed to git)
# In production, set these as actual environment variables

# PostgreSQL with pgvector - for vector embeddings
VECTOR_DB_URL=postgresql://pgvector:pgvector_dev@localhost:5432/pgvector

# MongoDB/FerretDB - for document storage
# Credentials must match docker-compose.yaml postgres-documentdb settings
DOC_DB_URL=mongodb://postgres:ferretdb_dev@localhost:27017/

# Embedding model (optional - defaults to BAAI/bge-large-en-v1.5)
# EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5

# Logging level (optional - defaults to INFO)
# LOG_LEVEL=INFO

# Ollama LLM configuration (optional - uses defaults if not set)
# OLLAMA_URL=http://localhost:11435
# OLLAMA_DEFAULT_MODEL=mistral
# OLLAMA_TEMPERATURE=0.7
# OLLAMA_MAX_TOKENS=2048
# OLLAMA_TIMEOUT=120
