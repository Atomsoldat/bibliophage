# Keep all __pycache__ dirs out of the source tree, mirrored under one root.
export PYTHONPYCACHEPREFIX := justfile_directory() + "/.pycache"

# GPU variant: cpu (default), gpu (NVIDIA), rocm (AMD)
extra := env("GPU_VENDOR", "cpu")

# Build the --extra flag only when a variant is set; empty GPU_VENDOR
# means "no extra" so we just run without one.
extra_flag := if extra == "" { "" } else { "--extra " + extra }

dev:
    uv run {{extra_flag}} python -m uvicorn --reload server:api_server

tests *args:
    uv run {{extra_flag}} --extra dev pytest tests {{args}}

lint: linter types deps ded

linter:
    uv run --extra dev ruff check

types:
    uv run --extra dev ty check

deps:
    uv run --extra dev deptry .

ded:
    uv run --extra dev vulture . --exclude bibliophage,.venv,__pycache__,__pytest_cache,.ruff_cache

coverage:
    uv run {{extra_flag}} --extra dev coverage run -m pytest

coverage-report:
    uv run --extra dev coverage report

api:
    uv run python -m grpc_tools.protoc \
        --proto_path=../api \
        --connect-python_out=./src \
        --python_out=./src \
        --pyi_out=./src \
        ../api/bibliophage/v1alpha3/*.proto
    touch src/bibliophage/__init__.py src/bibliophage/v1alpha3/__init__.py
