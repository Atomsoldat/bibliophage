# Flansch configuration example
# Copy to flansch.yaml and adjust as needed
# Environment variables override file settings: FLANSCH_SERVER_PORT, FLANSCH_ARCADEDB_HOST, etc.

server:
  host: "0.0.0.0"
  port: 9090

arcadedb:
  host: "localhost"
  port: 2480
  database: "bibliophage"
  username: "root"
  password: ""

log:
  level: "info"  # debug, info, warn, error
